@using SiGeP.UI.Data
@inject NavigationManager NavManager

@if (Visible)
{
    <div class="dlg-messageviewer-backdrop"></div>
    <div class="dlg-messageviewer @GetTypeCssClass()" role="dialog">
        <div class="dlg-messageviewer-header">
            <img class="rounded float-left pull-left p-2 mx-2" src="@ImageRoute" style="max-height: 4rem;" />
            <h3 class="dlg-messageviewer-title"> @Title </h3>
        </div>
        <div class="dlg-messageviewer-content">
            <p>@Message</p>
        </div>
        <div class="dlg-messageviewer-footer">
            @{
                switch (Type)
                {
                    case MessageTypes.Information:
                        <button type="button" class="btn btn-primary float-right mt-3" @onclick="@CloseMessage"> <i class="fas fa-check"></i> Continuar </button>
                        break;
                    case MessageTypes.InformationAction:
                        <button type="button" class="btn btn-primary float-right mt-3" @onclick="@OnClickAction"> <i class="fas fa-check"></i> Continuar </button>
                        break;
                    case MessageTypes.Error:
                    case MessageTypes.Warning:
                        <button type="button" class="btn btn-primary float-right mt-3" @onclick="@CloseMessage"> <i class="fas fa-check"></i> Continuar </button>
                        break;
                    case MessageTypes.Question:
                    case MessageTypes.Confirmation:
                        <div class="row mt-3 mx-3 float-right">
                            <button type="button" class="btn  btn-secondary  ml-2" @onclick="() => OnConfirmationChange(false)"> <i class="fas fa-times"></i> No </button>
                            <button type="button" class="btn  btn-primary  ml-2" @onclick="() => OnConfirmationChange(true)"> <i class="fas fa-check"></i> Si </button>
                        </div>
                        break;
                }
            }
        </div>
    </div>
}

<!--#region Styles  -->
<style>
    .dlg-messageviewer-backdrop {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        background-color: slategray;
        opacity: 0.6;
        z-index: 10000;
    }

    .dlg-messageviewer {
        position: fixed;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 500px;
        max-width: 95vw;
        max-height: 90vh;
        overflow-y: auto;
        background-color: white;
        border-radius: 4px;
        box-shadow: 0 2px 20px rgba(0,0,0,0.4);
        z-index: 10001;
        animation: dlg-messageviewer-fadezoom 0.4s ease;
    }

    @@keyframes dlg-messageviewer-fadezoom {
        from {
            opacity: 0;
            transform: translate(-50%, -50%) scale(0.85);
        }

        to {
            opacity: 1;
            transform: translate(-50%, -50%) scale(1);
        }
    }

    .dlg-messageviewer-header {
        display: flex;
        align-items: center;
        padding: 0.5rem 1rem;
    }

    .dlg-messageviewer-title {
        font-size: 20px;
        font-weight: normal;
        margin: 0;
    }

    .dlg-messageviewer-content {
        padding: 0 1rem 1rem 1rem;
    }

    .dlg-messageviewer-footer {
        padding: 0 1rem 1rem 1rem;
        overflow: auto;
    }

    .dlg-messageviewer .btn.e-flat {
        padding: 10px;
        border-color: transparent;
        background-color: RGB(122,155,232);
    }

    .CustomButton-Dialog {
        width: 4rem;
        border-radius: 5px;
    }

    /* Information / InformationAction */
    .dlg-messageviewer.dlg-type-information .dlg-messageviewer-title,
    .dlg-messageviewer.dlg-type-informationaction .dlg-messageviewer-title {
        color: navy;
    }

    .dlg-messageviewer.dlg-type-information,
    .dlg-messageviewer.dlg-type-informationaction {
        background-color: RGB(170,214,239);
    }

    /* Error */
    .dlg-messageviewer.dlg-type-error .dlg-messageviewer-title {
        color: red !important;
    }

    .dlg-messageviewer.dlg-type-error {
        background-color: RGB(239,170,181) !important;
    }

    /* Warning */
    .dlg-messageviewer.dlg-type-warning .dlg-messageviewer-title {
        color: RGB(204,102,0) !important;
    }

    .dlg-messageviewer.dlg-type-warning {
        background-color: #fbeaa8 !important;
    }

    /* Question / Confirmation */
    .dlg-messageviewer.dlg-type-question .dlg-messageviewer-title,
    .dlg-messageviewer.dlg-type-confirmation .dlg-messageviewer-title {
        color: black !important;
    }

    .dlg-messageviewer.dlg-type-question,
    .dlg-messageviewer.dlg-type-confirmation {
        background-color: white !important;
    }
</style>
<!--#endregion -->

@code {
    #region Vars

    public string Title { get; set; }

    public string Message { get; set; }

    public string Type { get; set; }

    public string Url { get; set; }

    private string ImageRoute { get; set; }

    private bool Visible = false;

    #endregion

    #region Methods

    public async Task ShowException(Exception ex)
    {
        switch (ex)
        {
            default:
                await ShowMessage(MessageTypes.Warning, ex.Message);
                break;
        }
    }

    public Task ShowMessage(string type, string message, string title = "", string url = "")
    {
        switch (type)
        {
            case MessageTypes.Information:
                Title ??= "Información";
                ImageRoute = "/images/information.png";
                break;
            case MessageTypes.InformationAction:
                Title ??= "Confirmación";
                ImageRoute = "/images/information.png";
                break;
            case MessageTypes.Confirmation:
                Title ??= "Atención";
                ImageRoute = "/images/question.png";
                break;
            case MessageTypes.Question:
                Title ??= "Información";
                ImageRoute = "/images/question.png";
                break;
            case MessageTypes.Warning:
                Title = "Advertencia";
                ImageRoute = "/images/warning.png";
                break;
            case MessageTypes.Error:
                Title = "Error";
                ImageRoute = "/images/error.png";
                break;
            default:
                break;
        }

        Title = !String.IsNullOrEmpty(title) ? title : Title;
        Type = type;
        Message = message;
        Url = url;
        Visible = true;

        StateHasChanged();

        return Task.CompletedTask;
    }

    #endregion

    #region Actions

    public void OnClickAction()
    {
        CloseMessage();
        NavManager.NavigateTo(Url);
    }

    public void CloseMessage()
    {
        Visible = false;
        StateHasChanged();
    }

    [Parameter]
    public EventCallback<bool> ConfirmationChanged { get; set; }

    protected async Task OnConfirmationChange(bool value)
    {
        CloseMessage();
        await ConfirmationChanged.InvokeAsync(value);
    }

    private string GetTypeCssClass()
    {
        return Type switch
        {
            MessageTypes.Information => "dlg-type-information",
            MessageTypes.InformationAction => "dlg-type-informationaction",
            MessageTypes.Confirmation => "dlg-type-confirmation",
            MessageTypes.Question => "dlg-type-question",
            MessageTypes.Warning => "dlg-type-warning",
            MessageTypes.Error => "dlg-type-error",
            _ => string.Empty
        };
    }

    #endregion
}
